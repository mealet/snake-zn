use zaylib.types;
use snake.config;

pub struct Point {
    pub x: i32,
    pub y: i32,

    pub fn rect(self) Rectangle {
        return Rectangle {
            .x = @as(f32, self.x * CELL) + PAD,
            .y = @as(f32, self.y * CELL + HUD) + PAD,
            .width = @as(f32, CELL) - PAD * 2.0,
            .height = @as(f32, CELL) - PAD * 2.0,
        };
    }

    pub fn center(self) Vector2 {
        return Vector2 {
            .x = @as(f32, self.x * CELL) + @as(f32, CELL) / 2.0,
            .y = @as(f32, self.y * CELL + HUD) + @as(f32, CELL) / 2.0,
        };
    }

    pub fn eq(self, other: Point) bool {
        return self.x == other.x && self.y == other.y;
    }

    pub fn plus(self, other: Point) Point {
        return Point { .x = self.x + other.x, .y = self.y + other.y };
    }

    pub fn inside(self) bool {
        return self.x >= 0 && self.x < COLS && self.y >= 0 && self.y < ROWS;
    }
}

implement Copy : Point {}
