use zaylib.types;
use zaylib.core;
use zaylib.shapes;
use zaylib.enums;
use zaylib.text;

use snake.config;
use snake.util;

const CAPACITY: i32 = 160;
const POPS: i32 = 16;

const OLDEST_START: f32 = 99999.0;
const POPUP_LIFE: f32 = 0.85;

pub struct Particle {
    pub x: f32,
    pub y: f32,
    pub vx: f32,
    pub vy: f32,
    pub life: f32,
    pub max: f32,
    pub size: f32,
    pub color: Color,
}

implement Copy : Particle {}

pub struct Popup {
    pub x: f32,
    pub y: f32,
    pub value: i32,
    pub life: f32,
    pub max: f32,
    pub color: Color,
}

implement Copy : Popup {}

pub struct Effects {
    pub parts: [160]Particle,
    pub pops: [16]Popup,
    pub shake: f32,
    pub flash_alpha: f32,
    pub flash_color: Color,

    pub fn new() Effects {
        return Effects {
            .parts = [Particle {
                .x = 0.0,
                .y = 0.0,
                .vx = 0.0,
                .vy = 0.0,
                .life = 0.0,
                .max = 0.0,
                .size = 0.0,
                .color = WHITE,
            }; 160],
            .pops = [Popup {
                .x = 0.0,
                .y = 0.0,
                .value = 0,
                .life = 0.0,
                .max = 0.0,
                .color = WHITE,
            }; 16],
            .shake = 0.0,
            .flash_alpha = 0.0,
            .flash_color = WHITE,
        };
    }

    pub fn clear(*self) void {
        for (i : CAPACITY) {
            self.parts[@as(usize, i)].life = 0.0;
        }

        for (p : POPS) {
            self.pops[@as(usize, p)].life = 0.0;
        }

        self.shake = 0.0;
        self.flash_alpha = 0.0;
    }

    pub fn kick(*self, amount: f32) void {
        if (amount > self.shake) {
            self.shake = amount;
        }
    }

    pub fn flash(*self, amount: f32, color: Color) void {
        if (amount > self.flash_alpha) {
            self.flash_alpha = amount;
            self.flash_color = color;
        }
    }

    pub fn offset(*const self) Vector2 {
        if (self.shake <= 0.0) {
            return Vector2 { .x = 0.0, .y = 0.0 };
        }

        return Vector2 {
            .x = @as(f32, GetRandomValue(-100, 100)) / 100.0 * self.shake,
            .y = @as(f32, GetRandomValue(-100, 100)) / 100.0 * self.shake,
        };
    }

    pub fn burst(*self, center: Vector2, color: Color, count: i32, speed: f32, size: f32) void {
        for (i : count) {
            let dx = @as(f32, GetRandomValue(-100, 100)) / 100.0;
            let dy = @as(f32, GetRandomValue(-100, 100)) / 100.0;
            let speed_jitter = speed * (0.30 + @as(f32, GetRandomValue(0, 100)) / 140.0);
            let life = 0.40 + @as(f32, GetRandomValue(0, 45)) / 100.0;
            let jitter = @as(f32, GetRandomValue(-4, 4));

            self.emit(
                center.x + jitter,
                center.y + jitter,
                dx * speed_jitter,
                dy * speed_jitter,
                life,
                size,
                color,
            );
        }
    }

    pub fn popup(*self, at: Vector2, value: i32, color: Color) void {
        let slot = self.free_pop();

        self.pops[@as(usize, slot)] = Popup {
            .x = at.x,
            .y = at.y - 12.0,
            .value = value,
            .life = POPUP_LIFE,
            .max = POPUP_LIFE,
            .color = color,
        };
    }

    fn emit(*self, x: f32, y: f32, vx: f32, vy: f32, life: f32, size: f32, color: Color) void {
        let slot = self.free_slot();

        self.parts[@as(usize, slot)] = Particle {
            .x = x,
            .y = y,
            .vx = vx,
            .vy = vy,
            .life = life,
            .max = life,
            .size = size,
            .color = color,
        };
    }

    fn free_slot(*const self) i32 {
        let best = 0;
        let oldest = OLDEST_START;

        for (i : CAPACITY) {
            let life = self.parts[@as(usize, i)].life;

            if (life <= 0.0) {
                return i;
            }

            if (life < oldest) {
                oldest = life;
                best = i;
            }
        }

        return best;
    }

    fn free_pop(*const self) i32 {
        let best = 0;
        let oldest = OLDEST_START;

        for (i : POPS) {
            let life = self.pops[@as(usize, i)].life;

            if (life <= 0.0) {
                return i;
            }

            if (life < oldest) {
                oldest = life;
                best = i;
            }
        }

        return best;
    }

    pub fn update(*self, dt: f32) void {
        let decay = Paint.clamp01(1.0 - 7.0 * dt);
        self.shake *= decay;

        if (self.shake < 0.12) {
            self.shake = 0.0;
        }

        self.flash_alpha *= Paint.clamp01(1.0 - 4.5 * dt);

        if (self.flash_alpha < 0.01) {
            self.flash_alpha = 0.0;
        }

        for (i : CAPACITY) {
            let part = self.parts[@as(usize, i)];

            if (part.life > 0.0) {
                self.step_part(i, part, dt);
            }
        }

        for (p : POPS) {
            let pop = self.pops[@as(usize, p)];

            if (pop.life > 0.0) {
                self.pops[@as(usize, p)].life = pop.life - dt;
                self.pops[@as(usize, p)].y = pop.y - 34.0 * dt;
            }
        }
    }

    fn step_part(*self, index: i32, part: Particle, dt: f32) void {
        let life = part.life - dt;

        if (life <= 0.0) {
            self.parts[@as(usize, index)].life = 0.0;
        } else {
            self.parts[@as(usize, index)].life = life;
            self.parts[@as(usize, index)].x = part.x + part.vx * dt;
            self.parts[@as(usize, index)].y = part.y + part.vy * dt;
            self.parts[@as(usize, index)].vx = part.vx * 0.985;
            self.parts[@as(usize, index)].vy = part.vy * 0.985 + 210.0 * dt;
        }
    }

    pub fn draw(*const self) void {
        BeginBlendMode(BLEND_ADDITIVE);

        for (part : self.parts) {
            if (part.life > 0.0) {
                let fade = Paint.clamp01(part.life / part.max);
                let radius = part.size * (0.30 + 0.70 * fade);

                DrawCircleV(Vector2 { .x = part.x, .y = part.y }, radius, Paint.fade(part.color, fade));
            }
        }

        EndBlendMode();
    }

    pub fn draw_pops(*const self, paint: *const Paint) void {
        for (pop : self.pops) {
            if (pop.life > 0.0) {
                let fade = Paint.clamp01(pop.life / pop.max);
                let text = @as([*]const char, TextFormat("+%i", pop.value));
                let size: i32 = 22;
                let x = @as(i32, pop.x) - paint.heavy_width(text, size) / 2;

                paint.heavy_text(text, x, @as(i32, pop.y), size, Paint.fade(pop.color, fade));
            }
        }
    }

    pub fn draw_flash(*const self) void {
        if (self.flash_alpha > 0.0) {
            DrawRectangle(0, 0, SCREEN_W, SCREEN_H, Paint.fade(self.flash_color, self.flash_alpha));
        }
    }
}
