use zaylib.types;
use zaylib.core;
use zaylib.shapes;
use snake.config;
use snake.types;
use snake.util;

pub struct Food {
    pub cell: Point,

    pub fn at(cell: Point) Food {
        return Food { .cell = cell };
    }

    pub fn random() Food {
        return Food.at(Point {
            .x = GetRandomValue(0, COLS - 1),
            .y = GetRandomValue(0, ROWS - 1),
        });
    }

    pub fn draw(self) void {
        let center = self.cell.center();
        let radius = @as(f32, CELL) * 0.30;
        DrawCircleV(center, radius, FOOD);
        DrawCircleV(
            Vector2 { .x = center.x - radius * 0.35, .y = center.y - radius * 0.35 },
            radius * 0.30,
            Paint.mix(FOOD, WHITE, 0.55),
        );
    }
}
