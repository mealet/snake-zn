use zaylib.types;
use zaylib.core;
use zaylib.enums;
use zaylib.shapes;
use zaylib.text;

use snake.config;
use snake.types;
use snake.util;
use snake.audio;
use snake.snake;
use snake.food;
use snake.effects;

const ITEM_PLAY: i32 = 0;
const ITEM_MODE: i32 = 1;
const ITEM_QUIT: i32 = 2;
const MENU_ITEMS: i32 = 3;

const REVEAL_DELAY: f32 = 0.55;
const SWIPE_MIN: f32 = 28.0;
const MENU_TITLE_Y: i32 = @os[android] { 480 } else { 108 };
const MENU_Y: i32 = @os[android] { 700 } else { 300 };
const MENU_GAP: i32 = @os[android] { 68 } else { 64 };

pub struct Game {
    pub snake: Snake,
    pub food: Food,
    pub gold: Food,
    pub effects: Effects,
    pub paint: Paint,
    pub audio: Audio,
    pub state: GameState,
    pub menu: i32,
    pub wrap: bool,
    pub score: i32,
    pub combo: i32,
    pub combo_time: f32,
    pub gold_life: f32,
    pub gold_spark: f32,
    pub death_t: f32,
    pub shots: i32,
    pub quit: bool,
    pub touch_start: Vector2,
    pub touch_active: bool,

    pub fn spawn() Game {
        let game = Game {
            .snake = Snake.spawn(),
            .food = Food.at(Point { .x = 0, .y = 0 }),
            .gold = Food.at(Point { .x = 0, .y = 0 }),
            .effects = Effects.new(),
            .paint = Paint.load(),
            .audio = Audio.load(),
            .state = GameState.Menu,
            .menu = ITEM_PLAY,
            .wrap = false,
            .score = 0,
            .combo = 0,
            .combo_time = 0.0,
            .gold_life = 0.0,
            .gold_spark = 0.0,
            .death_t = 0.0,
            .shots = 0,
            .quit = false,
            .touch_start = Vector2 { .x = 0.0, .y = 0.0 },
            .touch_active = false,
        };

        game.place_food();

        return game;
    }

    pub fn hotkeys(*self) void {
        if (IsKeyPressed(KEY_F11)) {
            ToggleFullscreen();
        }

        if (IsKeyPressed(KEY_F12)) {
            self.shots += 1;
            TakeScreenshot(@as([*]const char, TextFormat("snake_%i.png", self.shots)));
        }
    }

    pub fn input(*self) void {
        let view = View.current();
        let pointer = view.pointer();
        let gesture = self.pointer_gesture(pointer);

        if (!self.is_menu() && gesture.tap) {
            if (CheckCollisionPointRec(pointer, self.hud_menu_rect())) {
                self.state = GameState.Menu;
                self.audio.resume_sound();
                return;
            }

            if (CheckCollisionPointRec(pointer, self.hud_pause_rect())) {
                self.toggle_pause();
                return;
            }
        }

        switch (self.state) {
            .Menu => {
                if (IsKeyPressed(KEY_UP)) { self.menu_move(-1); }
                if (IsKeyPressed(KEY_DOWN)) { self.menu_move(1); }

                if (IsKeyPressed(KEY_ENTER) || IsKeyPressed(KEY_SPACE)) { self.menu_select(); }

                if (gesture.swipe.y < 0) { self.menu_move(-1); }
                if (gesture.swipe.y > 0) { self.menu_move(1); }
                if (gesture.tap) { self.menu_tap(pointer); }

                if (IsKeyPressed(KEY_BACK)) { self.quit = true; }
            },
            .Playing => {
                self.steer();

                if (gesture.swipe.x != 0 || gesture.swipe.y != 0) {
                    self.snake.turn(gesture.swipe);
                }

                if (IsKeyPressed(KEY_ESCAPE) || IsKeyPressed(KEY_BACK)) {
                    self.toggle_pause();
                }
            },
            .Paused => {
                if (gesture.tap || IsKeyPressed(KEY_ESCAPE) || IsKeyPressed(KEY_ENTER) || IsKeyPressed(KEY_BACK)) {
                    self.toggle_pause();
                }

                if (IsKeyPressed(KEY_Q)) {
                    self.state = GameState.Menu;
                    self.audio.resume_sound();
                }
            },
            .Over => {
                self.end_input();

                if (gesture.tap) {
                    self.audio.select_sound();
                    self.start();
                }

                if (IsKeyPressed(KEY_BACK)) {
                    self.state = GameState.Menu;
                    self.audio.resume_sound();
                }
            },
            .Win => {
                self.end_input();

                if (gesture.tap) {
                    self.audio.select_sound();
                    self.start();
                }

                if (IsKeyPressed(KEY_BACK)) {
                    self.state = GameState.Menu;
                    self.audio.resume_sound();
                }
            },
        }
    }

    pub fn update(*self, dt: f32) void {
        if (self.is_playing()) {
            self.step_combo(dt);
            self.step_gold(dt);

            if (self.snake.tick(dt)) {
                self.step();
            }
        }

        if (!self.is_paused() && !self.is_menu()) {
            self.effects.update(dt);
            self.death_t += dt;
        }
    }

    pub fn draw(*const self) void {
        let view = View.current();

        if (self.is_menu()) {
            BeginMode2D(view.camera(Vector2 { .x = 0.0, .y = 0.0 }));
            self.draw_menu();
            EndMode2D();
            return;
        }

        BeginMode2D(view.camera(self.effects.offset()));
        self.draw_world();
        self.effects.draw();
        self.effects.draw_pops(&self.paint);
        EndMode2D();

        BeginMode2D(view.camera(Vector2 { .x = 0.0, .y = 0.0 }));
        self.draw_hud();
        self.effects.draw_flash();
        self.draw_overlay();
        EndMode2D();
    }

    pub fn start(*self) void {
        self.restart();
        self.state = GameState.Playing;
    }

    pub fn restart(*self) void {
        self.snake.reset();
        self.effects.clear();
        self.score = 0;
        self.combo = 0;
        self.combo_time = 0.0;
        self.gold_life = 0.0;
        self.death_t = 0.0;

        self.place_food();
    }

    fn is_menu(*const self) bool {
        return switch (self.state) {
            .Menu => true,
            _ => false,
        };
    }

    fn is_playing(*const self) bool {
        return switch (self.state) {
            .Playing => true,
            _ => false,
        };
    }

    fn is_paused(*const self) bool {
        return switch (self.state) {
            .Paused => true,
            _ => false,
        };
    }

    fn toggle_pause(*self) void {
        if (self.is_playing()) {
            self.state = GameState.Paused;
            self.audio.pause_sound();
            return;
        }

        if (self.is_paused()) {
            self.state = GameState.Playing;
            self.audio.resume_sound();
        }
    }

    fn is_over(*const self) bool {
        return switch (self.state) {
            .Over => true,
            .Win => true,
            _ => false,
        };
    }

    fn menu_move(*self, delta: i32) void {
        self.menu = (self.menu + delta + MENU_ITEMS) % MENU_ITEMS;
        self.audio.move_sound();
    }

    fn menu_select(*self) void {
        self.audio.select_sound();

        switch (self.menu) {
            ITEM_PLAY => { self.start(); },
            ITEM_MODE => { self.wrap = !self.wrap; },
            ITEM_QUIT => { self.quit = true; },
            _ => {},
        }
    }

    fn end_input(*self) void {
        if (IsKeyPressed(KEY_R)) {
            self.audio.select_sound();
            self.start();
        }

        if (IsKeyPressed(KEY_ESCAPE) || IsKeyPressed(KEY_ENTER)) {
            self.state = GameState.Menu;
            self.audio.resume_sound();
        }
    }

    fn steer(*self) void {
        if (IsKeyPressed(KEY_UP) || IsKeyPressed(KEY_W)) {
            self.snake.turn(Point { .x = 0, .y = -1 });
        }

        if (IsKeyPressed(KEY_DOWN) || IsKeyPressed(KEY_S)) {
            self.snake.turn(Point { .x = 0, .y = 1 });
        }

        if (IsKeyPressed(KEY_LEFT) || IsKeyPressed(KEY_A)) {
            self.snake.turn(Point { .x = -1, .y = 0 });
        }

        if (IsKeyPressed(KEY_RIGHT) || IsKeyPressed(KEY_D)) {
            self.snake.turn(Point { .x = 1, .y = 0 });
        }
    }

    fn pointer_gesture(*self, pointer: Vector2) Gesture {
        if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
            self.touch_start = pointer;
            self.touch_active = true;
        }

        let idle = Gesture { .tap = false, .swipe = Point { .x = 0, .y = 0 } };

        if (!self.touch_active || !IsMouseButtonReleased(MOUSE_BUTTON_LEFT)) {
            return idle;
        }

        self.touch_active = false;

        let dx = pointer.x - self.touch_start.x;
        let dy = pointer.y - self.touch_start.y;
        let ax = if (dx < 0.0) { -dx } else { dx };
        let ay = if (dy < 0.0) { -dy } else { dy };

        if (ax < SWIPE_MIN && ay < SWIPE_MIN) {
            return Gesture { .tap = true, .swipe = Point { .x = 0, .y = 0 } };
        }

        if (ax > ay) {
            return Gesture {
                .tap = false,
                .swipe = Point { .x = if (dx > 0.0) { 1 } else { -1 }, .y = 0 },
            };
        }

        return Gesture {
            .tap = false,
            .swipe = Point { .x = 0, .y = if (dy > 0.0) { 1 } else { -1 } },
        };
    }

    fn menu_tap(*self, pointer: Vector2) void {
        let i: i32 = 0;

        while (i < MENU_ITEMS) {
            if (CheckCollisionPointRec(pointer, self.menu_rect(i))) {
                self.menu = i;
                self.menu_select();
                return;
            }

            i += 1;
        }
    }

    fn place_food(*self) void {
        let cell = self.free_cell(Option.None);

        if (cell.is_some()) {
            self.food = Food.at(cell.unwrap());
        }
    }

    fn free_cell(*const self, blocked: Option[Point]) Option[Point] {
        let pick = Point { .x = 0, .y = 0 };
        let total: i32 = 0;

        let y: i32 = 0;
        while (y < ROWS) {
            let x: i32 = 0;
            while (x < COLS) {
                let cell = Point { .x = x, .y = y };
                let free = !self.snake.occupies(cell) && (blocked.is_none() || !cell.eq(blocked.unwrap()));

                if (free) {
                    total += 1;

                    if (GetRandomValue(1, total) == 1) {
                        pick = cell;
                    }
                }

                x += 1;
            }

            y += 1;
        }

        if (total == 0) {
            return Option.None;
        }

        return Option.Some(pick);
    }

    fn step(*self) void {
        self.snake.commit();

        let head = self.snake.next_head();

        if (self.wrap) {
            head = head.wrap();
        }

        let eating = head.eq(self.food.cell);
        let golden = self.gold_life > 0.0 && head.eq(self.gold.cell);
        let grow = eating || golden;

        if (!head.inside() || self.snake.hits_self(head, grow)) {
            self.die();
        } else {
            self.snake.advance(head, grow);

            if (eating) {
                self.on_eat();
            }

            if (golden) {
                self.on_gold();
            }

            if (self.snake.len >= COLS * ROWS) {
                self.win();
            }
        }
    }

    fn die(*self) void {
        self.state = GameState.Over;
        self.death_t = 0.0;
        self.audio.death_sound();

        self.effects.kick(16.0);
        self.effects.flash(0.55, DANGER);
        self.explode(DANGER);
    }

    fn win(*self) void {
        self.state = GameState.Win;
        self.death_t = 0.0;
        self.audio.win_sound();

        self.effects.kick(11.0);
        self.effects.flash(0.42, GOLD);
        self.explode(GOLD);
    }

    fn explode(*self, spark: Color) void {
        let span = if (self.snake.len > 1) { self.snake.len - 1 } else { 1 };
        let step = if (self.snake.len > 20) { 2 } else { 1 };

        let i: i32 = 0;
        while (i < self.snake.len) {
            let frac = @as(f32, i) / @as(f32, span);
            let color = Paint.mix(Paint.mix(SNAKE_HEAD, SNAKE_TAIL, frac), spark, 0.35);

            self.effects.burst(self.snake.body[@as(usize, i)].center(), color, 3, 175.0, 3.2);

            i += step;
        }
    }

    fn snake_alpha(*const self) f32 {
        if (self.is_over()) {
            return 0.35 + 0.65 * Paint.clamp01(1.0 - self.death_t / 0.8);
        }

        return 1.0;
    }

    fn on_eat(*self) void {
        let at = self.food.cell.center();

        self.bump_combo();
        self.audio.eat_sound(self.combo);

        let points = EAT_SCORE * self.combo;
        self.score += points;

        self.effects.popup(at, points, ACCENT);
        self.effects.burst(at, FOOD, 16, 190.0, 3.4);
        self.effects.burst(at, ACCENT, 7, 120.0, 2.4);
        self.effects.kick(3.5);

        self.snake.speed_up();
        self.place_food();
        self.maybe_spawn_gold();
    }

    fn on_gold(*self) void {
        let at = self.gold.cell.center();

        self.bump_combo();
        self.audio.gold_sound();

        self.score += GOLD_SCORE;

        self.effects.popup(at, GOLD_SCORE, GOLD);
        self.effects.burst(at, GOLD, 26, 240.0, 4.2);
        self.effects.burst(at, WHITE, 10, 140.0, 2.8);
        self.effects.kick(7.0);
        self.effects.flash(0.30, GOLD);

        self.snake.speed_up();
        self.gold_life = 0.0;
    }

    fn bump_combo(*self) void {
        self.combo += 1;

        if (self.combo > COMBO_MAX) {
            self.combo = COMBO_MAX;
        }

        self.combo_time = COMBO_WINDOW;
    }

    fn step_combo(*self, dt: f32) void {
        if (self.combo_time > 0.0) {
            self.combo_time -= dt;

            if (self.combo_time <= 0.0) {
                self.combo_time = 0.0;
                self.combo = 0;
            }
        }
    }

    fn step_gold(*self, dt: f32) void {
        if (self.gold_life <= 0.0) {
            return;
        }

        self.gold_life -= dt;

        if (self.gold_life <= 0.0) {
            self.gold_life = 0.0;
            return;
        }

        self.gold_spark -= dt;

        if (self.gold_spark > 0.0) {
            return;
        }

        self.gold_spark = GOLD_SPARK;

        let at = self.gold.cell.center();
        self.effects.burst(
            Vector2 {
                .x = at.x + @as(f32, GetRandomValue(-10, 10)),
                .y = at.y + @as(f32, GetRandomValue(-10, 10)),
            },
            GOLD,
            2,
            45.0,
            1.7,
        );
    }

    fn maybe_spawn_gold(*self) void {
        if (self.gold_life > 0.0 || GetRandomValue(1, 100) > GOLD_CHANCE) {
            return;
        }

        let cell = self.free_cell(Option.Some(self.food.cell));

        if (cell.is_none()) {
            return;
        }

        self.gold = Food.gold_at(cell.unwrap());
        self.gold_life = GOLD_LIFE;
        self.gold_spark = 0.0;
    }

    fn draw_world(*const self) void {
        Game.draw_grid();

        if (self.gold_life > 0.0) {
            self.gold.draw(Paint.clamp01(self.gold_life / GOLD_LIFE));
        }

        self.food.draw(1.0);
        self.snake.draw(self.snake_alpha());
    }

    fn draw_hud(*const self) void {
        DrawRectangle(0, 0, SCREEN_W, HUD, PANEL);
        DrawRectangle(0, HUD - 1, SCREEN_W, 1, BORDER);

        let mode = Game.mode_short(self.wrap);
        let mode_y = HUD / 2 - HUD_MODE_SIZE / 2;
        let x = HUD_PAD;

        self.paint.text(mode, x, mode_y, HUD_MODE_SIZE, TEXT_DIM);
        x += self.paint.width(mode, HUD_MODE_SIZE) + HUD_GAP;

        self.paint.text("SCORE", x, mode_y, HUD_LABEL_SIZE, TEXT_DIM);
        x += self.paint.width("SCORE", HUD_LABEL_SIZE) + 10;

        let score_text = @as([*]const char, TextFormat("%i", self.score));
        let score_w = self.paint.width(score_text, HUD_SCORE_SIZE);
        let score_y = HUD / 2 - HUD_SCORE_SIZE / 2 - 2;

        self.paint.heavy_text(score_text, x, score_y, HUD_SCORE_SIZE, ACCENT);
        self.draw_combo(x + score_w + HUD_GAP);
        self.draw_hud_buttons();
    }

    fn draw_combo(*const self, x: i32) void {
        if (self.combo < 2) {
            return;
        }

        let text = @as([*]const char, TextFormat("x%i", self.combo));
        let y = HUD / 2 - HUD_COMBO_SIZE / 2 - 2;
        self.paint.heavy_text(text, x, y, HUD_COMBO_SIZE, GOLD);

        let frac = Paint.clamp01(self.combo_time / COMBO_WINDOW);
        let bar_y = HUD - 7;

        DrawRectangle(x, bar_y, HUD_COMBO_BAR, 3, Paint.fade(GOLD, 0.22));
        DrawRectangle(x, bar_y, @as(i32, @as(f32, HUD_COMBO_BAR) * frac), 3, GOLD);
    }

    fn draw_hud_buttons(*const self) void {
        let pause = self.hud_pause_rect();
        let menu = self.hud_menu_rect();

        DrawRectangleRounded(pause, 0.28, 6, Paint.fade(TEXT, 0.10));
        DrawRectangleRounded(menu, 0.28, 6, Paint.fade(TEXT, 0.10));

        let pause_x = pause.x + pause.width / 2.0;
        let pause_y = pause.y + pause.height / 2.0;
        let bar_w = pause.width * 0.13;
        let bar_h = pause.height * 0.42;
        let bar_gap = pause.width * 0.10;
        let bar_y = pause_y - bar_h / 2.0;

        DrawRectangle(
            @as(i32, pause_x - bar_gap - bar_w),
            @as(i32, bar_y),
            @as(i32, bar_w),
            @as(i32, bar_h),
            TEXT,
        );
        DrawRectangle(
            @as(i32, pause_x + bar_gap),
            @as(i32, bar_y),
            @as(i32, bar_w),
            @as(i32, bar_h),
            TEXT,
        );

        let menu_x = menu.x + menu.width / 2.0;
        let menu_y = menu.y + menu.height / 2.0;
        let line_w = menu.width * 0.46;
        let line_h = menu.height * 0.075;
        let line_gap = menu.height * 0.15;
        let line_x = menu_x - line_w / 2.0;
        let line: i32 = -1;

        while (line <= 1) {
            DrawRectangle(
                @as(i32, line_x),
                @as(i32, menu_y + @as(f32, line) * line_gap - line_h / 2.0),
                @as(i32, line_w),
                @as(i32, line_h),
                TEXT,
            );

            line += 1;
        }
    }

    fn hud_pause_rect(*const self) Rectangle {
        let menu = self.hud_menu_rect();

        return Rectangle {
            .x = menu.x - @as(f32, HUD_ICON + HUD_ICON_GAP),
            .y = menu.y,
            .width = menu.width,
            .height = menu.height,
        };
    }

    fn hud_menu_rect(*const self) Rectangle {
        let size = @as(f32, HUD_ICON);

        return Rectangle {
            .x = @as(f32, SCREEN_W - HUD_ICON_PAD) - size,
            .y = @as(f32, (HUD - HUD_ICON) / 2),
            .width = size,
            .height = size,
        };
    }

    fn draw_overlay(*const self) void {
        let revealed = self.death_t > REVEAL_DELAY;

        switch (self.state) {
            .Paused => { self.draw_paused(); },
            .Over => {
                if (revealed) {
                    self.draw_over();
                }
            },
            .Win => {
                if (revealed) {
                    self.draw_win();
                }
            },
            _ => {},
        }
    }

    fn draw_menu_item(*const self, index: i32) void {
        let text = self.menu_label(index);
        let size: i32 = 32;
        let width = self.paint.width(text, size);
        let x = (SCREEN_W - width) / 2;
        let y = MENU_Y + MENU_GAP * index;
        let active = index == self.menu;

        if (active) {
            DrawRectangleRounded(self.menu_rect(index), 0.45, 8, Paint.fade(ACCENT, 0.16));
        }

        let color = if (active) { ACCENT } else { TEXT_DIM };

        self.paint.text(text, x, y, size, color);
    }

    fn menu_rect(*const self, index: i32) Rectangle {
        let text = self.menu_label(index);
        let size: i32 = 32;
        let width = self.paint.width(text, size);
        let x = (SCREEN_W - width) / 2;
        let y = MENU_Y + MENU_GAP * index;

        return Rectangle {
            .x = @as(f32, x - 22),
            .y = @as(f32, y - 8),
            .width = @as(f32, width + 44),
            .height = @as(f32, size + 16),
        };
    }

    fn menu_label(*const self, index: i32) [*]const char {
        if (index == ITEM_MODE) {
            return Game.mode_label(self.wrap);
        }

        if (index == ITEM_QUIT) {
            return "QUIT";
        }

        return "PLAY";
    }

    fn draw_menu(*const self) void {
        let title: [*]const char = "ZEEN SNAKE";
        let title_size: i32 = 72;

        self.paint.heavy_text(title, self.paint.heavy_center_x(title, title_size), MENU_TITLE_Y, title_size, SNAKE_HEAD);

        self.draw_menu_item(ITEM_PLAY);
        self.draw_menu_item(ITEM_MODE);
        self.draw_menu_item(ITEM_QUIT);
    }

    fn draw_paused(*const self) void {
        DrawRectangle(0, 0, SCREEN_W, SCREEN_H, SHADE);

        let title: [*]const char = "PAUSED";
        let size: i32 = 56;

        self.paint.heavy_text(
            title,
            self.paint.heavy_center_x(title, size),
            Game.field_mid() - size - 10,
            size,
            TEXT,
        );

        let sub: [*]const char = @os[android] { "Tap To Resume" } else { "Esc to resume" };

        self.paint.text(sub, self.paint.center_x(sub, 18), Game.field_mid() + 20, 18, TEXT_DIM);
    }

    fn draw_over(*const self) void {
        let sub: [*]const char = @os[android] { "Tap To Restart" } else { "Press \"R\" to restart" };

        DrawRectangle(0, 0, SCREEN_W, SCREEN_H, SHADE);
        self.draw_notice(
            "GAME OVER",
            @as([*]const char, TextFormat("SCORE %i", self.score)),
            sub,
            TEXT,
        );
    }

    fn draw_win(*const self) void {
        let sub: [*]const char = @os[android] { "Tap To Restart" } else { "Press \"R\" to restart" };

        DrawRectangle(0, 0, SCREEN_W, SCREEN_H, SHADE);
        self.draw_notice(
            "YOU WIN",
            @as([*]const char, TextFormat("SCORE %i", self.score)),
            sub,
            ACCENT,
        );
    }

    fn draw_notice(*const self, title: [*]const char, mid: [*]const char, sub: [*]const char, accent: Color) void {
        let title_size: i32 = 64;
        let mid_size: i32 = 26;
        let sub_size: i32 = 20;
        let gap: i32 = 14;
        let pad_x: i32 = 48;
        let pad_y: i32 = 30;

        let title_w = self.paint.heavy_width(title, title_size);
        let mid_w = self.paint.width(mid, mid_size);
        let sub_w = self.paint.width(sub, sub_size);
        let inner = if (title_w > mid_w) { title_w } else { mid_w };

        if (sub_w > inner) {
            inner = sub_w;
        }

        let panel_w = inner + pad_x * 2;
        let panel_h = title_size + mid_size + sub_size + gap * 2 + pad_y * 2;
        let panel_x = (SCREEN_W - panel_w) / 2;
        let panel_y = HUD + (ROWS * CELL - panel_h) / 2;

        Paint.panel(panel_x, panel_y, panel_w, panel_h);

        let y = panel_y + pad_y;
        self.paint.heavy_text(title, (SCREEN_W - title_w) / 2, y, title_size, accent);
        y += title_size + gap;
        self.paint.text(mid, (SCREEN_W - mid_w) / 2, y, mid_size, TEXT);
        y += mid_size + gap;
        self.paint.text(sub, (SCREEN_W - sub_w) / 2, y, sub_size, TEXT_DIM);
    }

    fn draw_grid() void {
        let c: i32 = 0;
        while (c <= COLS) {
            DrawLine(c * CELL, HUD, c * CELL, SCREEN_H, GRID);
            c += 1;
        }

        let r: i32 = 0;
        while (r <= ROWS) {
            DrawLine(0, HUD + r * CELL, SCREEN_W, HUD + r * CELL, GRID);
            r += 1;
        }
    }

    fn mode_label(wrap: bool) [*]const char {
        if (wrap) {
            return "MODE  WRAP";
        }

        return "MODE  WALLS";
    }

    fn mode_short(wrap: bool) [*]const char {
        if (wrap) {
            return "WRAP";
        }

        return "WALLS";
    }

    fn field_mid() i32 {
        return HUD + (ROWS * CELL) / 2;
    }
}
