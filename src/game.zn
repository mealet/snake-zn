use zaylib.types;
use zaylib.core;
use zaylib.enums;
use zaylib.shapes;
use zaylib.text;
use snake.config;
use snake.types;
use snake.util;
use snake.snake;
use snake.food;
use snake.effects;

const ITEM_PLAY: i32 = 0;
const ITEM_MODE: i32 = 1;
const ITEM_QUIT: i32 = 2;
const MENU_ITEMS: i32 = 3;

pub struct Game {
    pub snake: Snake,
    pub food: Food,
    pub gold: Food,
    pub effects: Effects,
    pub paint: Paint,
    pub state: GameState,
    pub menu: i32,
    pub wrap: bool,
    pub score: i32,
    pub combo: i32,
    pub combo_time: f32,
    pub gold_life: f32,
    pub gold_spark: f32,
    pub death_t: f32,
    pub shots: i32,
    pub quit: bool,

    pub fn spawn() Game {
        let game = Game {
            .snake = Snake.spawn(),
            .food = Food.random(),
            .gold = Food.random(),
            .effects = Effects.new(),
            .paint = Paint.load(),
            .state = GameState.Menu,
            .menu = ITEM_PLAY,
            .wrap = false,
            .score = 0,
            .combo = 0,
            .combo_time = 0.0,
            .gold_life = 0.0,
            .gold_spark = 0.0,
            .death_t = 0.0,
            .shots = 0,
            .quit = false,
        };
        game.avoid_snake();
        return game;
    }

    pub fn hotkeys(*self) void {
        if (IsKeyPressed(KEY_F11)) {
            ToggleFullscreen();
        }
        if (IsKeyPressed(KEY_F12)) {
            self.shots += 1;
            TakeScreenshot(@as([*]const char, TextFormat("snake_%i.png", self.shots)));
        }
    }

    pub fn input(*self) void {
        switch (self.state) {
            .Menu => {
                if (IsKeyPressed(KEY_UP)) { self.menu_move(-1); }
                if (IsKeyPressed(KEY_DOWN)) { self.menu_move(1); }
                if (IsKeyPressed(KEY_ENTER) || IsKeyPressed(KEY_SPACE)) { self.menu_select(); }
            },
            .Playing => {
                self.steer();
                if (IsKeyPressed(KEY_ESCAPE)) { self.state = GameState.Paused; }
            },
            .Paused => {
                if (IsKeyPressed(KEY_ESCAPE) || IsKeyPressed(KEY_ENTER)) { self.state = GameState.Playing; }
                if (IsKeyPressed(KEY_Q)) { self.state = GameState.Menu; }
            },
            .Over => { self.end_input(); },
            .Win => { self.end_input(); },
        }
    }

    pub fn update(*self, dt: f32) void {
        if (self.is_playing()) {
            self.step_combo(dt);
            self.step_gold(dt);
            if (self.snake.tick(dt)) {
                self.step();
            }
        }
        if (!self.is_paused() && !self.is_menu()) {
            self.effects.update(dt);
            self.death_t += dt;
        }
    }

    pub fn draw(*const self) void {
        if (self.is_menu()) {
            self.draw_menu();
        } else {
            let camera = Camera2D {
                .offset = self.effects.offset(),
                .target = Vector2 { .x = 0.0, .y = 0.0 },
                .rotation = 0.0,
                .zoom = 1.0,
            };
            BeginMode2D(camera);
            self.draw_world();
            self.effects.draw();
            self.effects.draw_pops(&self.paint);
            EndMode2D();
            self.draw_hud();
            self.effects.draw_flash();
            self.draw_overlay();
        }
    }

    pub fn start(*self) void {
        self.restart();
        self.state = GameState.Playing;
    }

    pub fn restart(*self) void {
        self.snake.reset();
        self.effects.clear();
        self.score = 0;
        self.combo = 0;
        self.combo_time = 0.0;
        self.gold_life = 0.0;
        self.death_t = 0.0;
        self.food = Food.random();
        self.avoid_snake();
    }

    fn is_menu(*const self) bool {
        return switch (self.state) {
            .Menu => true,
            _ => false,
        };
    }

    fn is_playing(*const self) bool {
        return switch (self.state) {
            .Playing => true,
            _ => false,
        };
    }

    fn is_paused(*const self) bool {
        return switch (self.state) {
            .Paused => true,
            _ => false,
        };
    }

    fn is_over(*const self) bool {
        return switch (self.state) {
            .Over => true,
            .Win => true,
            _ => false,
        };
    }

    fn menu_move(*self, delta: i32) void {
        self.menu = (self.menu + delta + MENU_ITEMS) % MENU_ITEMS;
    }

    fn menu_select(*self) void {
        switch (self.menu) {
            ITEM_PLAY => { self.start(); },
            ITEM_MODE => { self.wrap = !self.wrap; },
            ITEM_QUIT => { self.quit = true; },
            _ => {},
        }
    }

    fn end_input(*self) void {
        if (IsKeyPressed(KEY_R)) { self.start(); }
        if (IsKeyPressed(KEY_ESCAPE) || IsKeyPressed(KEY_ENTER)) { self.state = GameState.Menu; }
    }

    fn steer(*self) void {
        if (IsKeyPressed(KEY_UP) || IsKeyPressed(KEY_W)) {
            self.snake.turn(Point { .x = 0, .y = -1 });
        }
        if (IsKeyPressed(KEY_DOWN) || IsKeyPressed(KEY_S)) {
            self.snake.turn(Point { .x = 0, .y = 1 });
        }
        if (IsKeyPressed(KEY_LEFT) || IsKeyPressed(KEY_A)) {
            self.snake.turn(Point { .x = -1, .y = 0 });
        }
        if (IsKeyPressed(KEY_RIGHT) || IsKeyPressed(KEY_D)) {
            self.snake.turn(Point { .x = 1, .y = 0 });
        }
    }

    fn avoid_snake(*self) void {
        let guard: i32 = 0;
        while (guard < 256) {
            if (!self.snake.occupies(self.food.cell)) {
                break;
            }
            self.food = Food.random();
            guard += 1;
        }
    }

    fn step(*self) void {
        self.snake.commit();
        let head = self.snake.next_head();
        if (self.wrap) {
            head = head.wrap();
        }
        let eating = head.eq(self.food.cell);
        let golden = self.gold_life > 0.0 && head.eq(self.gold.cell);
        let grow = eating || golden;
        if (!head.inside() || self.snake.hits_self(head, grow)) {
            self.die();
        } else {
            self.snake.advance(head, grow);
            if (eating) {
                self.on_eat();
            }
            if (golden) {
                self.on_gold();
            }
        }
    }

    fn die(*self) void {
        self.state = GameState.Over;
        self.death_t = 0.0;
        self.effects.kick(16.0);
        self.effects.flash(0.55, DANGER);
        self.explode(DANGER);
    }

    fn win(*self) void {
        self.state = GameState.Win;
        self.death_t = 0.0;
        self.effects.kick(11.0);
        self.effects.flash(0.42, GOLD);
        self.explode(GOLD);
    }

    fn explode(*self, spark: Color) void {
        let span = if (self.snake.len > 1) { self.snake.len - 1 } else { 1 };
        let step = if (self.snake.len > 20) { 2 } else { 1 };
        let i: i32 = 0;
        while (i < self.snake.len) {
            let frac = @as(f32, i) / @as(f32, span);
            let color = Paint.mix(Paint.mix(SNAKE_HEAD, SNAKE_TAIL, frac), spark, 0.35);
            self.effects.burst(self.snake.body[@as(usize, i)].center(), color, 3, 175.0, 3.2);
            i += step;
        }
    }

    fn snake_alpha(*const self) f32 {
        if (self.is_over()) {
            return 0.35 + 0.65 * Paint.clamp01(1.0 - self.death_t / 0.8);
        }
        return 1.0;
    }

    fn on_eat(*self) void {
        let at = self.food.cell.center();
        self.bump_combo();
        let points = 10 * self.combo;
        self.score += points;
        self.effects.popup(at, points, ACCENT);
        self.effects.burst(at, FOOD, 16, 190.0, 3.4);
        self.effects.burst(at, ACCENT, 7, 120.0, 2.4);
        self.effects.kick(3.5);
        self.snake.speed_up();
        self.food = Food.random();
        self.avoid_snake();
        self.maybe_spawn_gold();
        if (self.snake.len >= COLS * ROWS) {
            self.win();
        }
    }

    fn on_gold(*self) void {
        let at = self.gold.cell.center();
        self.bump_combo();
        self.score += GOLD_SCORE;
        self.effects.popup(at, GOLD_SCORE, GOLD);
        self.effects.burst(at, GOLD, 26, 240.0, 4.2);
        self.effects.burst(at, WHITE, 10, 140.0, 2.8);
        self.effects.kick(7.0);
        self.effects.flash(0.30, GOLD);
        self.snake.speed_up();
        self.gold_life = 0.0;
    }

    fn bump_combo(*self) void {
        self.combo += 1;
        if (self.combo > COMBO_MAX) {
            self.combo = COMBO_MAX;
        }
        self.combo_time = COMBO_WINDOW;
    }

    fn step_combo(*self, dt: f32) void {
        if (self.combo_time > 0.0) {
            self.combo_time -= dt;
            if (self.combo_time <= 0.0) {
                self.combo_time = 0.0;
                self.combo = 0;
            }
        }
    }

    fn step_gold(*self, dt: f32) void {
        if (self.gold_life > 0.0) {
            self.gold_life -= dt;
            if (self.gold_life <= 0.0) {
                self.gold_life = 0.0;
            } else {
                self.gold_spark -= dt;
                if (self.gold_spark <= 0.0) {
                    self.gold_spark = 0.16;
                    let at = self.gold.cell.center();
                    self.effects.burst(
                        Vector2 {
                            .x = at.x + @as(f32, GetRandomValue(-10, 10)),
                            .y = at.y + @as(f32, GetRandomValue(-10, 10)),
                        },
                        GOLD,
                        2,
                        45.0,
                        1.7,
                    );
                }
            }
        }
    }

    fn maybe_spawn_gold(*self) void {
        if (self.gold_life <= 0.0 && GetRandomValue(1, 100) <= GOLD_CHANCE) {
            self.gold = Food.gold_at(self.gold_cell());
            self.gold_life = GOLD_LIFE;
            self.gold_spark = 0.0;
        }
    }

    fn gold_cell(*const self) Point {
        let cell = Food.random().cell;
        let guard: i32 = 0;
        while (guard < 256) {
            if (!self.snake.occupies(cell) && !cell.eq(self.food.cell)) {
                break;
            }
            cell = Food.random().cell;
            guard += 1;
        }
        return cell;
    }

    fn draw_world(*const self) void {
        Game.draw_grid();
        if (self.gold_life > 0.0) {
            self.gold.draw(Paint.clamp01(self.gold_life / GOLD_LIFE));
        }
        self.food.draw(1.0);
        self.snake.draw(self.snake_alpha());
    }

    fn draw_hud(*const self) void {
        DrawRectangle(0, 0, SCREEN_W, HUD, PANEL);
        DrawRectangle(0, HUD - 1, SCREEN_W, 1, BORDER);
        self.paint.text("SCORE", 16, 16, 16, TEXT_DIM);

        let score_text = @as([*]const char, TextFormat("%i", self.score));
        let score_w = self.paint.width(score_text, 22);
        let score_x = 16 + self.paint.width("SCORE", 16) + 10;
        self.paint.heavy_text(score_text, score_x, 12, 22, ACCENT);
        self.draw_combo(score_x + score_w + 22);

        let mode: [*]const char = if (self.wrap) { @as([*]const char, "WRAP") } else { @as([*]const char, "WALLS") };
        self.paint.text(mode, SCREEN_W / 2 - self.paint.width(mode, 16) / 2, 16, 16, TEXT_DIM);
    }

    fn draw_combo(*const self, x: i32) void {
        if (self.combo >= 2) {
            let text = @as([*]const char, TextFormat("x%i", self.combo));
            self.paint.heavy_text(text, x, 14, 20, GOLD);
            let bar_w: i32 = 48;
            let frac = Paint.clamp01(self.combo_time / COMBO_WINDOW);
            DrawRectangle(x, 41, bar_w, 3, Paint.fade(GOLD, 0.22));
            DrawRectangle(x, 41, @as(i32, @as(f32, bar_w) * frac), 3, GOLD);
        }
    }

    fn draw_overlay(*const self) void {
        let revealed = self.death_t > 0.55;
        switch (self.state) {
            .Paused => { self.draw_paused(); },
            .Over => {
                if (revealed) {
                    self.draw_over();
                }
            },
            .Win => {
                if (revealed) {
                    self.draw_win();
                }
            },
            _ => {},
        }
    }

    fn draw_menu_item(*const self, text: [*]const char, index: i32, y: i32) void {
        let size: i32 = 32;
        let width = self.paint.width(text, size);
        let x = (SCREEN_W - width) / 2;
        let active = index == self.menu;
        if (active) {
            DrawRectangleRounded(
                Rectangle {
                    .x = @as(f32, x - 22),
                    .y = @as(f32, y - 8),
                    .width = @as(f32, width + 44),
                    .height = @as(f32, size + 16),
                },
                0.45,
                8,
                Paint.fade(ACCENT, 0.16),
            );
        }
        let color = if (active) { ACCENT } else { TEXT_DIM };
        self.paint.text(text, x, y, size, color);
    }

    fn draw_menu(*const self) void {
        let title: [*]const char = "ZEEN SNAKE";
        let title_size: i32 = 72;
        self.paint.heavy_text(title, self.paint.heavy_center_x(title, title_size), 108, title_size, SNAKE_HEAD);

        let y0: i32 = 300;
        let gap: i32 = 64;
        self.draw_menu_item("PLAY", ITEM_PLAY, y0);
        self.draw_menu_item(Game.mode_label(self.wrap), ITEM_MODE, y0 + gap);
        self.draw_menu_item("QUIT", ITEM_QUIT, y0 + gap * 2);

        self.draw_hint();
    }

    fn draw_hint(*const self) void {
        let hint: [*]const char = "Navigate With ↓ / ↑";
        let size: i32 = 20;
        self.paint.text(hint, self.paint.center_x(hint, size), SCREEN_H - 62, size, TEXT_DIM);
    }

    fn draw_paused(*const self) void {
        DrawRectangle(0, 0, SCREEN_W, SCREEN_H, SHADE);

        let title: [*]const char = "PAUSED";
        let size: i32 = 56;
        self.paint.heavy_text(
            title,
            self.paint.heavy_center_x(title, size),
            HUD + (ROWS * CELL) / 2 - size - 10,
            size,
            TEXT,
        );

        let sub: [*]const char = "Esc to resume";
        self.paint.text(sub, self.paint.center_x(sub, 18), HUD + (ROWS * CELL) / 2 + 20, 18, TEXT_DIM);
    }

    fn draw_over(*const self) void {
        DrawRectangle(0, 0, SCREEN_W, SCREEN_H, SHADE);
        self.draw_notice(
            "GAME OVER",
            @as([*]const char, TextFormat("SCORE %i", self.score)),
            "Press \"R\" to restart",
            TEXT,
        );
    }

    fn draw_win(*const self) void {
        DrawRectangle(0, 0, SCREEN_W, SCREEN_H, SHADE);
        self.draw_notice(
            "YOU WIN",
            @as([*]const char, TextFormat("SCORE %i", self.score)),
            "Press \"R\" to restart",
            ACCENT,
        );
    }

    fn draw_notice(*const self, title: [*]const char, mid: [*]const char, sub: [*]const char, accent: Color) void {
        let title_size: i32 = 64;
        let mid_size: i32 = 26;
        let sub_size: i32 = 20;
        let gap: i32 = 14;
        let pad_x: i32 = 48;
        let pad_y: i32 = 30;

        let title_w = self.paint.heavy_width(title, title_size);
        let mid_w = self.paint.width(mid, mid_size);
        let sub_w = self.paint.width(sub, sub_size);
        let inner = if (title_w > mid_w) { title_w } else { mid_w };
        if (sub_w > inner) {
            inner = sub_w;
        }
        let panel_w = inner + pad_x * 2;
        let panel_h = title_size + mid_size + sub_size + gap * 2 + pad_y * 2;
        let panel_x = (SCREEN_W - panel_w) / 2;
        let panel_y = HUD + (ROWS * CELL - panel_h) / 2;

        Paint.panel(panel_x, panel_y, panel_w, panel_h);
        let y = panel_y + pad_y;
        self.paint.heavy_text(title, (SCREEN_W - title_w) / 2, y, title_size, accent);
        y += title_size + gap;
        self.paint.text(mid, (SCREEN_W - mid_w) / 2, y, mid_size, TEXT);
        y += mid_size + gap;
        self.paint.text(sub, (SCREEN_W - sub_w) / 2, y, sub_size, TEXT_DIM);
    }

    fn draw_grid() void {
        let c: i32 = 0;
        while (c <= COLS) {
            DrawLine(c * CELL, HUD, c * CELL, SCREEN_H, GRID);
            c += 1;
        }
        let r: i32 = 0;
        while (r <= ROWS) {
            DrawLine(0, HUD + r * CELL, SCREEN_W, HUD + r * CELL, GRID);
            r += 1;
        }
    }

    fn mode_label(wrap: bool) [*]const char {
        if (wrap) {
            return "MODE  WRAP";
        }
        return "MODE  WALLS";
    }
}
