use std.math;

use zaylib.types;
use zaylib.core;
use zaylib.enums;
use zaylib.shapes;
use zaylib.text;
use zaylib.textures;

use snake.config;

const FONT_REGULAR: [*]const char = "assets/JetBrainsMono-Regular.ttf";
const FONT_HEAVY: [*]const char = "assets/JetBrainsMono-Bold.ttf";
const BASE_SIZE: i32 = 96;
const GLYPHS: i32 = 99;

pub fn asset(path: [*]const char) [*]const char {
    @os[android] {
        return path;
    }

    let dir = GetApplicationDirectory();
    let local = @as([*]const char, TextFormat("%s%s", dir, path));

    if (FileExists(local)) {
        return local;
    }

    let resources = @as([*]const char, TextFormat("%s../Resources/%s", dir, path));

    if (FileExists(resources)) {
        return resources;
    }

    return path;
}

pub struct Paint {
    pub font: Font,
    pub heavy: Font,

    pub fn load() Paint {
        return Paint {
            .font = Paint.face(asset(FONT_REGULAR)),
            .heavy = Paint.face(asset(FONT_HEAVY)),
        };
    }

    fn face(path: [*]const char) Font {
        let cps: [99]i32 = [0; 99];

        for (i : 95) {
            cps[@as(usize, i)] = 32 + i;
        }

        cps[95] = 8592;
        cps[96] = 8593;
        cps[97] = 8594;
        cps[98] = 8595;

        let font = LoadFontEx(path, BASE_SIZE, @as([*]const i32, &cps[0]), GLYPHS);
        SetTextureFilter(font.texture, TEXTURE_FILTER_BILINEAR);

        return font;
    }

    pub fn width(*const self, text: [*]const char, size: i32) i32 {
        return @as(i32, MeasureTextEx(self.font, text, @as(f32, size), 0.0).x);
    }

    pub fn heavy_width(*const self, text: [*]const char, size: i32) i32 {
        return @as(i32, MeasureTextEx(self.heavy, text, @as(f32, size), 0.0).x);
    }

    pub fn text(*const self, text: [*]const char, x: i32, y: i32, size: i32, color: Color) void {
        DrawTextEx(self.font, text, Vector2 { .x = @as(f32, x), .y = @as(f32, y) }, @as(f32, size), 0.0, color);
    }

    pub fn heavy_text(*const self, text: [*]const char, x: i32, y: i32, size: i32, color: Color) void {
        DrawTextEx(self.heavy, text, Vector2 { .x = @as(f32, x), .y = @as(f32, y) }, @as(f32, size), 0.0, color);
    }

    pub fn center_x(*const self, text: [*]const char, size: i32) i32 {
        return (SCREEN_W - self.width(text, size)) / 2;
    }

    pub fn heavy_center_x(*const self, text: [*]const char, size: i32) i32 {
        return (SCREEN_W - self.heavy_width(text, size)) / 2;
    }

    pub fn panel(x: i32, y: i32, w: i32, h: i32) void {
        let rec = Rectangle {
            .x = @as(f32, x),
            .y = @as(f32, y),
            .width = @as(f32, w),
            .height = @as(f32, h),
        };

        DrawRectangleRounded(rec, 0.10, 10, PANEL);
        DrawRectangleRoundedLinesEx(rec, 0.10, 10, 1.0, BORDER);
    }

    pub fn mix(a: Color, b: Color, t: f32) Color {
        let u = Paint.clamp01(t);

        return Color {
            .r = @as(u8, @as(f32, a.r) + (@as(f32, b.r) - @as(f32, a.r)) * u),
            .g = @as(u8, @as(f32, a.g) + (@as(f32, b.g) - @as(f32, a.g)) * u),
            .b = @as(u8, @as(f32, a.b) + (@as(f32, b.b) - @as(f32, a.b)) * u),
            .a = 255,
        };
    }

    pub fn fade(c: Color, alpha: f32) Color {
        return Color { .r = c.r, .g = c.g, .b = c.b, .a = @as(u8, Paint.clamp01(alpha) * 255.0) };
    }

    pub fn clamp01(t: f32) f32 {
        return clamp(t, 0.0, 1.0);
    }

    pub fn wave(speed: f32) f32 {
        let t = @as(f32, GetTime()) * speed;
        let frac = t - @as(f32, @as(i32, t));

        if (frac < 0.5) {
            return frac * 2.0;
        }

        return (1.0 - frac) * 2.0;
    }
}

pub struct View {
    pub offset: Vector2,
    pub zoom: f32,

    pub fn current() View {
        let w = @as(f32, GetScreenWidth());
        let h = @as(f32, GetScreenHeight()) - @as(f32, SAFE_BOTTOM);
        let sx = w / @as(f32, SCREEN_W);
        let sy = h / @as(f32, SCREEN_H);
        let zoom: f32 = min(sx, sy);

        return View {
            .offset = Vector2 {
                .x = (w - @as(f32, SCREEN_W) * zoom) / 2.0,
                .y = (h - @as(f32, SCREEN_H) * zoom) / 2.0,
            },
            .zoom = zoom,
        };
    }

    pub fn camera(self, shake: Vector2) Camera2D {
        return Camera2D {
            .offset = Vector2 {
                .x = self.offset.x + shake.x * self.zoom,
                .y = self.offset.y + shake.y * self.zoom,
            },
            .target = Vector2 { .x = 0.0, .y = 0.0 },
            .rotation = 0.0,
            .zoom = self.zoom,
        };
    }

    pub fn pointer(self) Vector2 {
        let p = GetMousePosition();

        return Vector2 {
            .x = (p.x - self.offset.x) / self.zoom,
            .y = (p.y - self.offset.y) / self.zoom,
        };
    }
}

implement Copy : View {}
