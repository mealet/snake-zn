use zaylib.types;

pub const CELL: i32 = 30;
pub const COLS: i32 = 20;
pub const ROWS: i32 = 20;
pub const MAXLEN: i32 = 400;
pub const HUD: i32 = 48;

pub const SCREEN_W: i32 = COLS * CELL;
pub const SCREEN_H: i32 = ROWS * CELL + HUD;

pub const PAD: f32 = 2.0;

pub const STEP_START: f32 = 0.20;
pub const STEP_MIN: f32 = 0.075;
pub const STEP_DEC: f32 = 0.006;

pub const FIELD: Color = Color { .r = 30, .g = 30, .b = 30, .a = 255 };
pub const GRID: Color = Color { .r = 46, .g = 46, .b = 46, .a = 255 };
pub const PANEL: Color = Color { .r = 37, .g = 37, .b = 38, .a = 255 };
pub const BORDER: Color = Color { .r = 60, .g = 60, .b = 60, .a = 255 };
pub const SHADE: Color = Color { .r = 0, .g = 0, .b = 0, .a = 190 };

pub const SNAKE_HEAD: Color = Color { .r = 86, .g = 156, .b = 214, .a = 255 };
pub const SNAKE_TAIL: Color = Color { .r = 38, .g = 79, .b = 120, .a = 255 };
pub const FOOD: Color = Color { .r = 209, .g = 105, .b = 105, .a = 255 };

pub const TEXT: Color = Color { .r = 212, .g = 212, .b = 212, .a = 255 };
pub const TEXT_DIM: Color = Color { .r = 133, .g = 133, .b = 133, .a = 255 };
pub const ACCENT: Color = Color { .r = 78, .g = 201, .b = 176, .a = 255 };
pub const WHITE: Color = Color { .r = 255, .g = 255, .b = 255, .a = 255 };
pub const EYE: Color = Color { .r = 16, .g = 22, .b = 32, .a = 255 };
