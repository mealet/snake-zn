use std.time;

use zaylib.core;
use zaylib.enums;

use snake.config;
use snake.game;

fn main() {
    @os[android] {
        InitWindow(0, 0, "ZeenSnake");
    } else {
        InitWindow(SCREEN_W, SCREEN_H, "ZeenSnake");
    }

    SetTargetFPS(60);
    SetRandomSeed(@as(u32, Time.now()));
    SetExitKey(KEY_NULL);

    let game = Game.spawn();

    while (!WindowShouldClose() && !game.quit) {
        game.hotkeys();
        game.input();
        game.update(GetFrameTime());

        BeginDrawing();
        ClearBackground(FIELD);
        game.draw();
        EndDrawing();
    }

    game.audio.unload();
    // NOTE: CloseWindow() is deliberately not called: the MSVC linker resolves
    // that symbol from user32.lib (which Zeen links before user libraries),
    // colliding with raylib's own CloseWindow. The OS frees everything on exit.
}
