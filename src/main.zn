use zaylib.core;
use zaylib.enums;

use snake.config;
use snake.game;

fn main() {
    @os[android] {
        InitWindow(0, 0, "Zeen Snake");
    } else {
        InitWindow(SCREEN_W, SCREEN_H, "Zeen Snake");
    }

    SetTargetFPS(60);
    SetRandomSeed(@as(u32, 2024));
    SetExitKey(KEY_NULL);

    let game = Game.spawn();

    while (!WindowShouldClose() && !game.quit) {
        game.hotkeys();
        game.input();
        game.update(GetFrameTime());

        BeginDrawing();
        ClearBackground(FIELD);
        game.draw();
        EndDrawing();
    }

    game.audio.unload();
    CloseWindow();
}
