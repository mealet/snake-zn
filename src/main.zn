use zaylib.types;
use zaylib.colors;
use zaylib.core;
use zaylib.shapes;
use zaylib.text;
use zaylib.enums;

const CELL: i32 = 30;
const COLS: i32 = 20;
const ROWS: i32 = 20;
const MAXLEN: i32 = 400;
const HUD: i32 = 48;

const SCREEN_W: i32 = COLS * CELL;
const SCREEN_H: i32 = ROWS * CELL + HUD;

const STEP_START: f32 = 0.20;
const STEP_MIN: f32 = 0.075;
const STEP_DEC: f32 = 0.006;

const FIELD: Color = Color { .r = 30, .g = 30, .b = 30, .a = 255 };
const GRID: Color = Color { .r = 46, .g = 46, .b = 46, .a = 255 };
const PANEL: Color = Color { .r = 37, .g = 37, .b = 38, .a = 255 };
const BORDER: Color = Color { .r = 60, .g = 60, .b = 60, .a = 255 };
const SHADE: Color = Color { .r = 0, .g = 0, .b = 0, .a = 190 };

const SNAKE_HEAD: Color = Color { .r = 86, .g = 156, .b = 214, .a = 255 };
const SNAKE_TAIL: Color = Color { .r = 38, .g = 79, .b = 120, .a = 255 };
const FOOD: Color = Color { .r = 209, .g = 105, .b = 105, .a = 255 };

const TEXT: Color = Color { .r = 212, .g = 212, .b = 212, .a = 255 };
const TEXT_DIM: Color = Color { .r = 133, .g = 133, .b = 133, .a = 255 };
const ACCENT: Color = Color { .r = 78, .g = 201, .b = 176, .a = 255 };

struct Point {
    pub x: i32,
    pub y: i32,
}

implement Copy : Point {}

fn mix(a: Color, b: Color, t: f32) Color {
    let u = if (t < 0.0) { 0.0 } else { if (t > 1.0) { 1.0 } else { t } };
    return Color {
        .r = @as(u8, @as(f32, a.r) + (@as(f32, b.r) - @as(f32, a.r)) * u),
        .g = @as(u8, @as(f32, a.g) + (@as(f32, b.g) - @as(f32, a.g)) * u),
        .b = @as(u8, @as(f32, a.b) + (@as(f32, b.b) - @as(f32, a.b)) * u),
        .a = 255,
    };
}

fn same(a: Point, b: Point) bool {
    return a.x == b.x && a.y == b.y;
}

fn random_cell() Point {
    return Point {
        .x = GetRandomValue(0, COLS - 1),
        .y = GetRandomValue(0, ROWS - 1),
    };
}

fn draw_bold(text: [*]const char, x: i32, y: i32, size: i32, color: Color) void {
    let dx: i32 = 0;
    while (dx <= size / 40) {
        let dy: i32 = 0;
        while (dy <= size / 60) {
            DrawText(text, x + dx, y + dy, size, color);
            dy += 1;
        }
        dx += 1;
    }
}

fn draw_grid() void {
    let c: i32 = 0;
    while (c <= COLS) {
        DrawLine(c * CELL, HUD, c * CELL, SCREEN_H, GRID);
        c += 1;
    }
    let r: i32 = 0;
    while (r <= ROWS) {
        DrawLine(0, HUD + r * CELL, SCREEN_W, HUD + r * CELL, GRID);
        r += 1;
    }
}

fn cell_rect(cell: Point) Rectangle {
    return Rectangle {
        .x = @as(f32, cell.x * CELL) + 2.0,
        .y = @as(f32, cell.y * CELL + HUD) + 2.0,
        .width = @as(f32, CELL) - 4.0,
        .height = @as(f32, CELL) - 4.0,
    };
}

fn draw_food(cell: Point) void {
    let radius = @as(f32, CELL) * 0.30;
    let center = Vector2 {
        .x = @as(f32, cell.x * CELL) + @as(f32, CELL) / 2.0,
        .y = @as(f32, cell.y * CELL + HUD) + @as(f32, CELL) / 2.0,
    };
    DrawCircleV(center, radius, FOOD);
    DrawCircleV(
        Vector2 { .x = center.x - radius * 0.35, .y = center.y - radius * 0.35 },
        radius * 0.30,
        mix(FOOD, Color { .r = 255, .g = 255, .b = 255, .a = 255 }, 0.55),
    );
}

fn draw_snake(body: *const [400]Point, len: i32) void {
    let span = if (len > 1) { len - 1 } else { 1 };
    let i: i32 = 0;
    while (i < len) {
        let color = mix(SNAKE_HEAD, SNAKE_TAIL, @as(f32, i) / @as(f32, span));
        if (i == 0) {
            DrawRectangleRounded(cell_rect((*body)[0]), 0.45, 12, mix(SNAKE_HEAD, Color { .r = 255, .g = 255, .b = 255, .a = 255 }, 0.15));
        } else {
            DrawRectangleRounded(cell_rect((*body)[@as(usize, i)]), 0.35, 10, color);
        }
        i += 1;
    }
}

fn draw_hud(score: i32) void {
    DrawRectangle(0, 0, SCREEN_W, HUD, PANEL);
    DrawRectangle(0, HUD - 1, SCREEN_W, 1, BORDER);

    DrawText("SCORE", 16, 16, 16, TEXT_DIM);
    DrawText(
        @as([*]const char, TextFormat("%i", score)),
        16 + MeasureText("SCORE", 16) + 10,
        12,
        22,
        ACCENT,
    );

    let fps = @as([*]const char, TextFormat("FPS %i", GetFPS()));
    DrawText(fps, SCREEN_W - 16 - MeasureText(fps, 16), 17, 16, TEXT_DIM);
}

fn draw_game_over() void {
    DrawRectangle(0, 0, SCREEN_W, SCREEN_H, SHADE);

    let title: [*]const char = "GAME OVER";
    let sub: [*]const char = "Press \"R\" to restart";
    let title_size: i32 = 64;
    let sub_size: i32 = 22;
    let gap: i32 = 16;
    let pad_x: i32 = 44;
    let pad_y: i32 = 30;

    let title_w = MeasureText(title, title_size);
    let sub_w = MeasureText(sub, sub_size);
    let inner = if (title_w > sub_w) { title_w } else { sub_w };
    let panel_w = inner + pad_x * 2;
    let panel_h = title_size + gap + sub_size + pad_y * 2;
    let panel_x = (SCREEN_W - panel_w) / 2;
    let panel_y = HUD + (ROWS * CELL - panel_h) / 2;
    let panel = Rectangle {
        .x = @as(f32, panel_x),
        .y = @as(f32, panel_y),
        .width = @as(f32, panel_w),
        .height = @as(f32, panel_h),
    };

    DrawRectangleRounded(panel, 0.10, 10, PANEL);
    DrawRectangleRoundedLinesEx(panel, 0.10, 10, 1.0, BORDER);

    draw_bold(title, (SCREEN_W - title_w) / 2, panel_y + pad_y, title_size, TEXT);
    DrawText(sub, (SCREEN_W - sub_w) / 2, panel_y + pad_y + title_size + gap, sub_size, TEXT_DIM);
}

fn main() i32 {
    InitWindow(SCREEN_W, SCREEN_H, "Zeen Snake");
    SetTargetFPS(60);
    SetRandomSeed(@as(u32, 2024));

    let body: [400]Point = [Point { .x = 0, .y = 0 }; 400];
    let len: i32 = 3;
    let dir = Point { .x = 1, .y = 0 };
    let pending = dir;
    let food = random_cell();
    let score: i32 = 0;
    let over = false;
    let timer: f32 = 0.0;
    let step: f32 = STEP_START;

    body[0] = Point { .x = 10, .y = 10 };
    body[1] = Point { .x = 9, .y = 10 };
    body[2] = Point { .x = 8, .y = 10 };

    while (!WindowShouldClose()) {
        if (over) {
            if (IsKeyPressed(KEY_R)) {
                len = 3;
                dir = Point { .x = 1, .y = 0 };
                pending = dir;
                body[0] = Point { .x = 10, .y = 10 };
                body[1] = Point { .x = 9, .y = 10 };
                body[2] = Point { .x = 8, .y = 10 };
                score = 0;
                over = false;
                timer = 0.0;
                step = STEP_START;
                food = random_cell();
            }
        } else {
            if (IsKeyPressed(KEY_UP) && dir.y == 0) {
                pending = Point { .x = 0, .y = -1 };
            }
            if (IsKeyPressed(KEY_DOWN) && dir.y == 0) {
                pending = Point { .x = 0, .y = 1 };
            }
            if (IsKeyPressed(KEY_LEFT) && dir.x == 0) {
                pending = Point { .x = -1, .y = 0 };
            }
            if (IsKeyPressed(KEY_RIGHT) && dir.x == 0) {
                pending = Point { .x = 1, .y = 0 };
            }

            timer += GetFrameTime();
            if (timer >= step) {
                timer = 0.0;
                dir = pending;
                let head = Point { .x = body[0].x + dir.x, .y = body[0].y + dir.y };
                if (head.x < 0 || head.x >= COLS || head.y < 0 || head.y >= ROWS) {
                    over = true;
                } else {
                    let eating = same(head, food);
                    let limit = if (eating) { len } else { len - 1 };
                    let i: i32 = 0;
                    while (i < limit) {
                        if (same(body[@as(usize, i)], head)) {
                            over = true;
                        }
                        i += 1;
                    }
                    if (!over) {
                        let grow = eating && len < MAXLEN;
                        let j = if (grow) { len } else { len - 1 };
                        while (j > 0) {
                            body[@as(usize, j)] = body[@as(usize, j - 1)];
                            j -= 1;
                        }
                        body[0] = head;
                        if (grow) {
                            len += 1;
                        }
                        if (eating) {
                            score += 10;
                            step -= STEP_DEC;
                            if (step < STEP_MIN) {
                                step = STEP_MIN;
                            }
                            food = random_cell();
                            let guard: i32 = 0;
                            while (guard < 256) {
                                let hit = false;
                                let k: i32 = 0;
                                while (k < len) {
                                    if (same(body[@as(usize, k)], food)) {
                                        hit = true;
                                    }
                                    k += 1;
                                }
                                if (!hit) {
                                    break;
                                }
                                food = random_cell();
                                guard += 1;
                            }
                        }
                    }
                }
            }
        }

        BeginDrawing();
        ClearBackground(FIELD);
        draw_grid();
        draw_food(food);
        draw_snake(&body, len);
        draw_hud(score);
        if (over) {
            draw_game_over();
        }
        EndDrawing();
    }

    CloseWindow();
    return 0;
}
