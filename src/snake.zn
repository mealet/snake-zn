use zaylib.types;
use zaylib.shapes;
use snake.config;
use snake.types;
use snake.util;

pub struct Snake {
    pub body: [400]Point,
    pub len: i32,
    pub dir: Point,
    pub pending: Point,
    pub timer: f32,
    pub step: f32,

    pub fn spawn() Snake {
        let snake = Snake {
            .body = [Point { .x = 0, .y = 0 }; 400],
            .len = 0,
            .dir = Point { .x = 1, .y = 0 },
            .pending = Point { .x = 1, .y = 0 },
            .timer = 0.0,
            .step = STEP_START,
        };
        snake.reset();
        return snake;
    }

    pub fn reset(*self) void {
        self.len = 3;
        self.body[0] = Point { .x = 10, .y = 10 };
        self.body[1] = Point { .x = 9, .y = 10 };
        self.body[2] = Point { .x = 8, .y = 10 };
        self.dir = Point { .x = 1, .y = 0 };
        self.pending = self.dir;
        self.timer = 0.0;
        self.step = STEP_START;
    }

    pub fn turn(*self, d: Point) void {
        if (d.x != 0 && self.dir.x == 0) {
            self.pending = d;
        }
        if (d.y != 0 && self.dir.y == 0) {
            self.pending = d;
        }
    }

    pub fn commit(*self) void {
        self.dir = self.pending;
    }

    pub fn tick(*self, dt: f32) bool {
        self.timer += dt;
        if (self.timer >= self.step) {
            self.timer = 0.0;
            return true;
        }
        return false;
    }

    pub fn next_head(*const self) Point {
        return self.body[0].plus(self.dir);
    }

    pub fn advance(*self, next: Point, grow: bool) void {
        let j = if (grow) { self.len } else { self.len - 1 };
        while (j > 0) {
            self.body[@as(usize, j)] = self.body[@as(usize, j - 1)];
            j -= 1;
        }
        self.body[0] = next;
        if (grow) {
            self.len += 1;
        }
    }

    pub fn occupies(*const self, cell: Point) bool {
        let i: i32 = 0;
        while (i < self.len) {
            if (self.body[@as(usize, i)].eq(cell)) {
                return true;
            }
            i += 1;
        }
        return false;
    }

    pub fn hits_self(*const self, head: Point, eating: bool) bool {
        let limit = if (eating) { self.len } else { self.len - 1 };
        let i: i32 = 0;
        while (i < limit) {
            if (self.body[@as(usize, i)].eq(head)) {
                return true;
            }
            i += 1;
        }
        return false;
    }

    pub fn speed_up(*self) void {
        self.step -= STEP_DEC;
        if (self.step < STEP_MIN) {
            self.step = STEP_MIN;
        }
    }

    pub fn draw(*const self) void {
        let span = if (self.len > 1) { self.len - 1 } else { 1 };
        let i: i32 = 0;
        while (i < self.len) {
            let cell = self.body[@as(usize, i)];
            if (i == 0) {
                DrawRectangleRounded(cell.rect(), 0.45, 12, Paint.mix(SNAKE_HEAD, WHITE, 0.15));
            } else {
                let color = Paint.mix(SNAKE_HEAD, SNAKE_TAIL, @as(f32, i) / @as(f32, span));
                DrawRectangleRounded(cell.rect(), 0.35, 10, color);
            }
            i += 1;
        }
    }
}
