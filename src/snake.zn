use zaylib.types;
use zaylib.core;
use zaylib.enums;
use zaylib.shapes;

use snake.config;
use snake.types;
use snake.util;

const QUEUE_MAX: i32 = 3;

pub struct Snake {
    pub body: [400]Point,
    pub len: i32,
    pub dir: Point,
    pub queue: [3]Point,
    pub queue_len: i32,
    pub timer: f32,
    pub step: f32,
    pub tail_prev: Point,
    pub grew: bool,
    pub moved: bool,

    pub fn spawn() Snake {
        let snake = Snake {
            .body = [Point { .x = 0, .y = 0 }; 400],
            .len = 0,
            .dir = Point { .x = 1, .y = 0 },
            .queue = [Point { .x = 1, .y = 0 }; 3],
            .queue_len = 0,
            .timer = 0.0,
            .step = STEP_START,
            .tail_prev = Point { .x = 0, .y = 0 },
            .grew = false,
            .moved = false,
        };

        snake.reset();

        return snake;
    }

    pub fn reset(*self) void {
        self.len = 3;
        self.body[0] = Point { .x = 10, .y = 10 };
        self.body[1] = Point { .x = 9, .y = 10 };
        self.body[2] = Point { .x = 8, .y = 10 };

        self.dir = Point { .x = 1, .y = 0 };
        self.queue_len = 0;
        self.timer = 0.0;
        self.step = STEP_START;

        self.tail_prev = self.body[2];
        self.grew = false;
        self.moved = false;
    }

    pub fn turn(*self, d: Point) void {
        let last = if (self.queue_len > 0) {
            self.queue[@as(usize, self.queue_len - 1)]
        } else {
            self.dir
        };
        let same = d.x == last.x && d.y == last.y;
        let opposite = d.x + last.x == 0 && d.y + last.y == 0;

        if (!same && !opposite && self.queue_len < QUEUE_MAX) {
            self.queue[@as(usize, self.queue_len)] = d;
            self.queue_len += 1;
        }
    }

    pub fn commit(*self) void {
        if (self.queue_len > 0) {
            self.dir = self.queue[0];

            let i: i32 = 0;
            while (i < self.queue_len - 1) {
                self.queue[@as(usize, i)] = self.queue[@as(usize, i + 1)];
                i += 1;
            }

            self.queue_len -= 1;
        }
    }

    pub fn tick(*self, dt: f32) bool {
        self.timer += dt;

        if (self.timer >= self.step) {
            self.timer = 0.0;
            return true;
        }

        return false;
    }

    pub fn next_head(*const self) Point {
        return self.body[0].plus(self.dir);
    }

    pub fn advance(*self, next: Point, grow: bool) void {
        self.tail_prev = self.body[@as(usize, self.len - 1)];
        self.grew = grow;
        self.moved = true;

        let j = if (grow) { self.len } else { self.len - 1 };
        while (j > 0) {
            self.body[@as(usize, j)] = self.body[@as(usize, j - 1)];
            j -= 1;
        }

        self.body[0] = next;

        if (grow) {
            self.len += 1;
        }
    }

    pub fn prev_cell(*const self, i: i32) Point {
        if (!self.moved) {
            return self.body[@as(usize, i)];
        }

        if (i < self.len - 1) {
            return self.body[@as(usize, i + 1)];
        }

        if (self.grew) {
            return self.body[@as(usize, i)];
        }

        return self.tail_prev;
    }

    pub fn occupies(*const self, cell: Point) bool {
        let i: i32 = 0;

        while (i < self.len) {
            if (self.body[@as(usize, i)].eq(cell)) {
                return true;
            }
            i += 1;
        }

        return false;
    }

    pub fn hits_self(*const self, head: Point, eating: bool) bool {
        let limit = if (eating) { self.len } else { self.len - 1 };
        let i: i32 = 0;

        while (i < limit) {
            if (self.body[@as(usize, i)].eq(head)) {
                return true;
            }
            i += 1;
        }

        return false;
    }

    pub fn speed_up(*self) void {
        self.step -= STEP_DEC;

        if (self.step < STEP_MIN) {
            self.step = STEP_MIN;
        }
    }

    pub fn draw(*const self, alpha: f32) void {
        let travel = if (self.step > STEP_REST) { self.step - STEP_REST } else { self.step };
        let t = Paint.clamp01(self.timer / travel);

        let span = if (self.len > 1) { self.len - 1 } else { 1 };
        let base = @as(f32, CELL) - PAD * 2.0;

        let head_center = self.body[0].slide(self.prev_cell(0), t);
        Snake.halo(head_center, @as(f32, CELL) * 0.90 * (0.9 + 0.10 * Paint.wave(2.6)), SNAKE_HEAD, 0.22 * alpha);

        let i = self.len - 1;
        while (i >= 0) {
            let center = self.body[@as(usize, i)].slide(self.prev_cell(i), t);
            let frac = @as(f32, i) / @as(f32, span);
            let size = base * (1.0 - 0.45 * frac);
            let inset = size / 2.0;
            let color = if (i == 0) {
                Paint.mix(SNAKE_HEAD, WHITE, 0.15)
            } else {
                Paint.mix(SNAKE_HEAD, SNAKE_TAIL, frac)
            };

            DrawRectangleRounded(
                Rectangle { .x = center.x - inset, .y = center.y - inset, .width = size, .height = size },
                0.35,
                10,
                Paint.fade(color, alpha),
            );

            i -= 1;
        }

        self.draw_eyes(head_center, alpha);
    }

    fn halo(center: Vector2, radius: f32, color: Color, strength: f32) void {
        BeginBlendMode(BLEND_ADDITIVE);
        DrawCircleGradient(center, radius, Paint.fade(color, strength), Paint.fade(color, 0.0));
        EndBlendMode();
    }

    fn draw_eyes(*const self, center: Vector2, alpha: f32) void {
        let fwd = @as(f32, CELL) * 0.17;
        let side = @as(f32, CELL) * 0.19;
        let radius = @as(f32, CELL) * 0.10;

        let fx = @as(f32, self.dir.x) * fwd;
        let fy = @as(f32, self.dir.y) * fwd;
        let sx = -@as(f32, self.dir.y) * side;
        let sy = @as(f32, self.dir.x) * side;
        let eye = Paint.fade(EYE, alpha);

        DrawCircleV(Vector2 { .x = center.x + fx + sx, .y = center.y + fy + sy }, radius, eye);
        DrawCircleV(Vector2 { .x = center.x + fx - sx, .y = center.y + fy - sy }, radius, eye);
    }
}
